# ==============================================================================
# GetPass - Environment Variables Configuration
# ==============================================================================

# PostgreSQL Connection String
# En Railway: Puedes vincular la base de datos PostgreSQL interna usando: ${{Postgres.DATABASE_URL}}
# O cualquier otra base de datos PostgreSQL (Neon, Supabase, Render, Local):
DATABASE_URL="postgresql://usuario:contraseña@host:5432/nombre_base_datos"

# JWT Secrets (genera cadenas aleatorias con openssl rand -base64 32)
JWT_SECRET="genera_un_secreto_seguro_de_minimo_32_caracteres"
JWT_REFRESH_SECRET="genera_otro_secreto_seguro_de_minimo_32_caracteres"

# URL pública de tu aplicación (necesario para redirecciones, links compartidos y CORS)
# En Railway: Asigna un dominio público en Settings -> Domains y pégalo aquí (ej: https://getpass-production.up.railway.app)
NEXT_PUBLIC_APP_URL="https://tu-app.up.railway.app"

# Entorno de ejecución
NODE_ENV="production"
